{
  "name": "A2",
  "description": "A0 with a 4-minute per-task cap and 28 tool calls (the community budget-fit setting) instead of 6 min / 40. One variable: per-task budget, for the budget-allocation curve under the 12 h cap.",
  "model": "gemma-4-31b-it-qat-w4a16-ct",
  "tools": [
    "run_command",
    "read_file",
    "edit_file",
    "write_file",
    "get_status",
    "submit_patch",
    "get_code_neighbors",
    "search_similar_code",
    "get_code_subgraph"
  ],
  "sampling": {
    "temperature": 0.2,
    "top_p": 0.95,
    "max_output_tokens": 8192,
    "thinking_config": {
      "thinking_budget": 4096,
      "include_thoughts": true
    }
  },
  "evaluation": {
    "timeout_seconds": 120,
    "max_tool_calls": 28,
    "max_time_minutes": 4,
    "max_turns": 120
  }
}
